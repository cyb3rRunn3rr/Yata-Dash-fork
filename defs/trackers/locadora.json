  "abbr": "LCD",
  "url": "https://locadora.cc",
  "type": "scrape_only",
  "last_updated": "2026-07-29",
  "scrape": {
    "profile_path": "/users/{username}",
    "presence_flags": {
      "unread_mail":          { "link_suffix": "/conversations", "marker": "svg" },
      "unread_notifications": { "link_suffix": "/notifications", "marker": "svg" }
    },
    "labels": {
      "account upload (total)": "uploaded",
      "account download (total)": "downloaded",
      "total seeding": "seeding",
      "total leeching": "leeching",
      "bon": "bonus_points",
      "hit and run count (all time)": "hit_and_runs",
      "seeding size": "seed_size",
      "Total uploads (Non-Anonymous)": "uploads"
    }
  },
  "rules": {
    "min_ratio": 0.4,
    "min_seed_days": 3,
    "note": "Download is revoked below ratio 0.40, with more than 3 active hit and runs, or for new users with 3 or more downloads before meeting seed time."
